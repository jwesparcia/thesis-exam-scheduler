# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to '.env' inside the backend directory:
#   cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/exam_scheduler

# JWT Authentication Secret Key
# Generate a secure key in production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your-secret-key-for-development-only-change-in-production

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP Email Configuration (e.g., Gmail App Password or SMTP relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_specific_password
SMTP_SENDER=your_email@example.com
